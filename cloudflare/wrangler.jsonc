{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "video-remake-workshop",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "948468800cc249169fcab8ff2c2d11f7"
    }
  ],
  "vars": {
    "ACCESS_USER": "owner"
  }
}
